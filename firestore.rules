rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasMembership(projectId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(projectId)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(projectId)
        ).data.active == true;
    }

    function hasRole(projectId, roles) {
      return hasMembership(projectId)
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(projectId)
        ).data.role in roles;
    }

    function cxRuntimeMember(projectId) {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)
        ).data.active == true;
    }

    function cxRuntimeEditor(projectId) {
      return cxRuntimeMember(projectId)
        && get(
          /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)
        ).data.role in [
          "admin",
          "editor"
        ];
    }

    function cxRuntimeAdmin(projectId) {
      return cxRuntimeMember(projectId)
        && get(
          /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)
        ).data.role == "admin";
    }

    match /projects/{projectId} {
      /*
       * Project documents are read individually,
       * not by listing the entire projects collection.
       */
      allow get:
        if hasMembership(projectId);

      allow list:
        if false;

      /*
       * New projects are created manually for now.
       */
      allow create:
        if false;

      allow update, delete:
        if hasRole(
          projectId,
          ["admin"]
        );

      match /floors/{floorId} {
        allow read:
          if hasMembership(projectId);

        allow create, update, delete:
          if hasRole(
            projectId,
            ["admin"]
          );
      }

      match /floors/{floorId}/assignments/{recordId} {
        allow read:
          if cxRuntimeMember(projectId);

        allow create, update:
          if cxRuntimeAdmin(projectId)
          && request.resource.data.updatedByUid
            == request.auth.uid;

        allow delete:
          if false;
      }

      match /floors/{floorId}/comments/{recordId} {
        allow read:
          if cxRuntimeMember(projectId);

        allow create:
          if cxRuntimeEditor(projectId)
          && request.resource.data.createdByUid
            == request.auth.uid;

        allow update, delete:
          if false;
      }

      match /floors/{floorId}/checklistResults/{recordId} {
        allow read:
          if cxRuntimeMember(projectId);

        allow create, update:
          if cxRuntimeEditor(projectId)
          && request.resource.data.updatedByUid
            == request.auth.uid;

        allow delete:
          if false;
      }

      match /floors/{floorId}/testResults/{recordId} {
        allow read:
          if cxRuntimeMember(projectId);

        allow create, update:
          if cxRuntimeEditor(projectId)
          && request.resource.data.updatedByUid
            == request.auth.uid;

        allow delete:
          if false;
      }

      match /floors/{floorId}/panelTestResults/{recordId} {
        allow read:
          if cxRuntimeMember(projectId);

        allow create, update:
          if cxRuntimeEditor(projectId)
          && request.resource.data.updatedByUid
            == request.auth.uid;

        allow delete:
          if false;
      }

      match /floors/{floorId}/issues/{recordId} {
        allow read:
          if cxRuntimeMember(projectId);

        allow create:
          if cxRuntimeEditor(projectId)
          && request.resource.data.createdByUid
            == request.auth.uid;

        allow update:
          if cxRuntimeEditor(projectId)
          && request.resource.data.resolvedByUid
            == request.auth.uid;

        allow delete:
          if false;
      }

      match /floors/{floorId}/panelIssues/{recordId} {
        allow read:
          if cxRuntimeMember(projectId);

        allow create:
          if cxRuntimeEditor(projectId)
          && request.resource.data.createdByUid
            == request.auth.uid;

        allow update:
          if cxRuntimeEditor(projectId)
          && request.resource.data.resolvedByUid
            == request.auth.uid;

        allow delete:
          if false;
      }

      match /floors/{floorId}/activityEvents/{recordId} {
        allow read:
          if cxRuntimeMember(projectId);

        allow create:
          if cxRuntimeEditor(projectId)
          && request.resource.data.performedByUid
            == request.auth.uid;

        allow update, delete:
          if false;
      }
    }

    match /users/{userId} {
      allow get:
        if signedIn()
        && request.auth.uid == userId;

      allow list:
        if false;

      allow create, update, delete:
        if false;

      match /memberships/{projectId} {
        /*
         * Users can retrieve their own membership records.
         */
        allow get, list:
          if signedIn()
          && request.auth.uid == userId;

        /*
         * An existing project admin may manage
         * membership records later.
         */
        allow create, update, delete:
          if hasRole(
            projectId,
            ["admin"]
          );
      }
    }

    match /{document=**} {
      allow read, write:
        if false;
    }
  }
}